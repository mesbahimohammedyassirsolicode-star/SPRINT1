/* ============================================================
   Hôtel PMS — Back-office  (ANCIEN DESIGN — version d'origine)
   Backup de la feuille de style avant le redesign "noble floor".
   ============================================================ */

@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap');

:root {
  --surface-0: #FBF8F3;
  --surface-1: #F5F0E8;
  --surface-2: #ECE5D9;
  --surface-3: #E2D9CA;
  --ink:       #211D18;
  --ink-soft:  #574F44;
  --ink-faint: #8A7F6F;
  --border:    #DDD3C2;
  --border-strong: #C9BCA6;
  --accent:        #B85C2B;
  --accent-strong: #97471F;
  --accent-soft:   #F3E3D5;
  --accent-ink:    #FFFFFF;
  --ok:      #3E7C4F;
  --ok-soft: #E2EFE4;
  --warn:    #B07A1E;
  --warn-soft:#F6EDD8;
  --bad:     #A33A2E;
  --bad-soft:#F5E2DE;
  --info:    #2F6474;
  --info-soft:#DEEAED;
  --font-display: "Fraunces", Georgia, "Times New Roman", serif;
  --font-ui:       "Manrope", "Segoe UI", system-ui, sans-serif;
  --font-mono:     "JetBrains Mono", Consolas, monospace;
  --text-xs:  0.75rem;
  --text-sm:  0.8125rem;
  --text-md:  0.9375rem;
  --text-lg:  1.125rem;
  --text-xl:  1.375rem;
  --text-2xl: 1.75rem;
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 14px;
  --radius-xl: 20px;
  --space-1: 4px;
  --space-2: 8px;
  --space-3: 12px;
  --space-4: 16px;
  --space-5: 24px;
  --space-6: 32px;
  --space-7: 48px;
  --shadow-sm: 0 1px 2px rgba(33, 29, 24, 0.08);
  --shadow-md: 0 4px 12px rgba(33, 29, 24, 0.08);
  --shadow-lg: 0 12px 32px rgba(33, 29, 24, 0.12);
  --sidebar-w: 248px;
  --topbar-h: 60px;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { font-size: 16px; }

body {
  font-family: var(--font-ui);
  font-size: var(--text-md);
  line-height: 1.5;
  color: var(--ink);
  background: var(--surface-0);
  -webkit-font-smoothing: antialiased;
}

a { color: inherit; }
h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 600; line-height: 1.2; }

/* ============ LOGIN ============ */
.login-screen {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1.2fr 1fr;
}
.login-brand {
  background: linear-gradient(160deg, #211D18 0%, #3A2A1C 60%, #4E3B2D 100%);
  color: #F5F0E8;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: var(--space-7);
}
.login-brand .wordmark { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700; letter-spacing: 0.02em; }
.login-brand .wordmark span { color: #D98A5B; }
.login-brand blockquote {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  line-height: 1.35;
  max-width: 26ch;
}
.login-brand .caption { color: #C9BCA6; font-size: var(--text-sm); }
.login-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-6);
}
.login-card { width: 100%; max-width: 400px; }
.login-card h1 { font-size: var(--text-2xl); margin-bottom: var(--space-2); }
.login-card p.intro { color: var(--ink-soft); margin-bottom: var(--space-5); font-size: var(--text-sm); }
.login-card .tip {
  margin-top: var(--space-5);
  padding: var(--space-3) var(--space-4);
  background: var(--accent-soft);
  border-radius: var(--radius-md);
  color: var(--accent-strong);
  font-size: var(--text-sm);
}

/* ============ APP SHELL ============ */
.app { display: flex; min-height: 100vh; }

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: var(--sidebar-w);
  background: #211D18;
  color: #E8E0D3;
  display: flex;
  flex-direction: column;
  padding: var(--space-4);
  z-index: 30;
}
.sidebar .wordmark {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-2) var(--space-2) var(--space-4);
  border-bottom: 1px solid rgba(233, 224, 211, 0.15);
  margin-bottom: var(--space-4);
  text-decoration: none;
}
.sidebar .wordmark .crest {
  width: 40px; height: 40px;
  border-radius: var(--radius-md);
  background: linear-gradient(140deg, #B85C2B, #E0A06B);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-display);
  font-weight: 700; font-size: var(--text-lg);
  color: #211D18;
  flex-shrink: 0;
}
.sidebar .wordmark .name { font-family: var(--font-display); font-weight: 700; font-size: var(--text-lg); line-height: 1.1; }
.sidebar .wordmark .name em { font-style: normal; color: #D98A5B; }
.sidebar .wordmark .sub { font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: #A3947F; }
.sidebar nav { flex: 1; overflow-y: auto; }
.sidebar nav .section-label {
  font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
  color: #A3947F; padding: var(--space-4) var(--space-3) var(--space-2);
}
.sidebar nav a {
  display: flex; align-items: center; gap: var(--space-3);
  padding: 9px var(--space-3);
  border-radius: var(--radius-md);
  color: #D9D0C1;
  text-decoration: none;
  font-size: var(--text-sm);
  font-weight: 500;
  margin-bottom: 2px;
  transition: background 0.15s, color 0.15s;
}
.sidebar nav a .ico { width: 18px; text-align: center; opacity: 0.75; }
.sidebar nav a:hover { background: rgba(233, 224, 211, 0.08); color: #fff; }
.sidebar nav a.active { background: #B85C2B; color: #fff; font-weight: 600; }
.sidebar nav a.active .ico { opacity: 1; }
.sidebar .sidebar-foot { border-top: 1px solid rgba(233, 224, 211, 0.15); padding-top: var(--space-3); }
.sidebar .user-chip { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-2); }
.sidebar .user-chip .avatar {
  width: 34px; height: 34px; border-radius: 50%;
  background: var(--accent-soft); color: var(--accent-strong);
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: var(--text-sm); flex-shrink: 0;
}
.sidebar .user-chip .who b { display: block; font-size: var(--text-sm); color: #fff; }
.sidebar .user-chip .who span { font-size: 11px; color: #A3947F; }
.sidebar a.logout { display: block; margin-top: var(--space-2); text-align: center; font-size: var(--text-sm); color: #C9BCA6; text-decoration: none; padding: var(--space-2); border-radius: var(--radius-md); }
.sidebar a.logout:hover { color: #F0B8A4; background: rgba(233,224,211,0.06); }

.main { flex: 1; margin-left: var(--sidebar-w); display: flex; flex-direction: column; min-height: 100vh; }

.topbar {
  position: sticky; top: 0; z-index: 20;
  height: var(--topbar-h);
  background: rgba(251, 248, 243, 0.92);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--border);
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 var(--space-6);
}
.topbar h2 { font-size: var(--text-lg); }
.topbar .crumb { font-size: 11px; color: var(--ink-faint); letter-spacing: 0.05em; text-transform: uppercase; }
.topbar .top-actions { display: flex; gap: var(--space-3); align-items: center; }

.content { padding: var(--space-6); max-width: 1400px; width: 100%; margin: 0 auto; }

/* ============ CARTES ============ */
.card {
  background: var(--surface-1);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}
.card .card-head {
  padding: var(--space-4) var(--space-5);
  border-bottom: 1px solid var(--border);
  display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap;
}
.card .card-head h3 { font-size: var(--text-lg); }
.card .card-head p { font-size: var(--text-sm); color: var(--ink-soft); margin-top: 2px; }
.card .card-body { padding: var(--space-5); }

/* ============ KPI ============ */
.kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-5); }
.kpi {
  background: var(--surface-1);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: var(--space-4) var(--space-5);
  position: relative; overflow: hidden;
}
.kpi .kpi-label { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-soft); }
.kpi .kpi-value { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700; margin-top: var(--space-1); }
.kpi .kpi-value small { font-size: var(--text-md); color: var(--ink-faint); font-weight: 600; }
.kpi .kpi-note { font-size: var(--text-xs); color: var(--ink-faint); margin-top: var(--space-1); }
.kpi::after {
  content: ""; position: absolute; inset: 0 auto 0 0; width: 4px; background: var(--accent);
}
.kpi.sand::after { background: var(--ink-faint); }
.kpi.gold::after { background: var(--warn); }
.kpi.green::after { background: var(--ok); }
.kpi.red::after { background: var(--bad); }
.kpi.warn::after { background: var(--warn); }
.kpi.ok::after { background: var(--ok); }
.kpi.info::after { background: var(--info); }

/* ============ BADGES / STATUTS ============ */
.badge {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 11px; font-weight: 600;
  padding: 3px 10px; border-radius: 999px;
  white-space: nowrap;
}
.badge.ok   { background: var(--ok-soft);   color: var(--ok); }
.badge.warn { background: var(--warn-soft); color: var(--warn); }
.badge.bad  { background: var(--bad-soft);  color: var(--bad); }
.badge.info { background: var(--info-soft); color: var(--info); }
.badge.accent { background: var(--accent-soft); color: var(--accent-strong); }
.badge.neutral { background: var(--surface-3); color: var(--ink-soft); }
.stars { color: #C9892E; letter-spacing: 2px; }

/* ============ TABLEAUX ============ */
.table-wrap { overflow-x: auto; }
table.table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
table.table thead th {
  text-align: left; font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--ink-soft); font-weight: 700;
  padding: var(--space-3) var(--space-4);
  border-bottom: 1px solid var(--border);
  background: var(--surface-2);
  white-space: nowrap;
}
table.table tbody td {
  padding: var(--space-3) var(--space-4);
  border-bottom: 1px solid var(--border);
  vertical-align: middle;
}
table.table tbody tr:last-child td { border-bottom: none; }
table.table tbody tr:hover { background: var(--surface-2); }
table.table .cell-main { font-weight: 600; }
table.table .cell-sub { font-size: var(--text-xs); color: var(--ink-faint); }
table.table .num { font-family: var(--font-mono); font-weight: 600; }
table.table .empty td { text-align: center; color: var(--ink-faint); padding: var(--space-7) var(--space-4); font-size: var(--text-sm); }

.table-actions { display: flex; gap: 6px; justify-content: flex-end; }
.table-actions a, .row-action {
  display: inline-flex; align-items: center; justify-content: center;
  width: 30px; height: 30px; border-radius: var(--radius-sm);
  color: var(--ink-soft); text-decoration: none; font-size: var(--text-sm);
}
.table-actions a:hover { background: var(--surface-3); color: var(--ink); }
.table-actions a.danger:hover { background: var(--bad-soft); color: var(--bad); }

/* ============ BOUTONS ============ */
.btn {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--font-ui); font-size: var(--text-sm); font-weight: 600;
  padding: 9px 16px; border-radius: var(--radius-md);
  border: 1px solid transparent; cursor: pointer;
  text-decoration: none; line-height: 1.2; white-space: nowrap;
  transition: background 0.15s, border-color 0.15s, color 0.15s;
}
.btn.primary { background: var(--accent); color: var(--accent-ink); }
.btn.primary:hover { background: var(--accent-strong); }
.btn.secondary { background: var(--surface-1); border-color: var(--border-strong); color: var(--ink); }
.btn.secondary:hover { background: var(--surface-2); }
.btn.ghost { background: transparent; color: var(--ink-soft); border-color: transparent; }
.btn.ghost:hover { color: var(--ink); background: var(--surface-2); }
.btn.danger { background: var(--bad-soft); color: var(--bad); }
.btn.danger:hover { background: var(--bad); color: #fff; }
.btn.ok { background: var(--ok); color: #fff; }
.btn.ok:hover { filter: brightness(1.08); }
.btn.sm { padding: 6px 12px; font-size: var(--text-xs); border-radius: var(--radius-sm); }
.btn.block { width: 100%; justify-content: center; }

/* ============ FORMULAIRES ============ */
.form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-4); }
.form-group { display: flex; flex-direction: column; gap: 6px; }
.form-group label { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--ink-soft); }
.form-group label .req { color: var(--bad); }
.form-group input[type="text"], .form-group input[type="email"], .form-group input[type="password"],
.form-group input[type="number"], .form-group input[type="date"], .form-group input[type="datetime-local"],
.form-group input[type="tel"], .form-group select, .form-group textarea {
  font-family: var(--font-ui); font-size: var(--text-md); color: var(--ink);
  padding: 9px 12px; border: 1px solid var(--border-strong); border-radius: var(--radius-md);
  background: #fff;
  width: 100%;
  transition: border-color 0.15s, box-shadow 0.15s;
}
.form-group input:focus, .form-group select:focus, .form-group textarea:focus {
  outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(184, 92, 43, 0.18);
}
.form-group textarea { resize: vertical; min-height: 72px; }
.form-group .hint { font-size: var(--text-xs); color: var(--ink-faint); }
.form-actions { display: flex; gap: var(--space-3); align-items: center; margin-top: var(--space-5); }
.form-divider { border: none; border-top: 1px solid var(--border); margin: var(--space-5) 0; }

.check-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: var(--space-2); }
.check-item {
  display: flex; align-items: center; gap: var(--space-2);
  background: #fff; border: 1px solid var(--border);
  border-radius: var(--radius-md); padding: 8px 12px; font-size: var(--text-sm);
  cursor: pointer; transition: border-color 0.15s, background 0.15s;
}
.check-item:hover { border-color: var(--border-strong); }
.check-item:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); }
.check-item input { accent-color: var(--accent); }

.filter-bar {
  display: flex; gap: var(--space-3); align-items: center; flex-wrap: wrap;
  padding: var(--space-3) var(--space-4);
  background: var(--surface-1); border: 1px solid var(--border); border-radius: var(--radius-lg);
  margin-bottom: var(--space-4);
}
.filter-bar select, .filter-bar input[type="text"] {
  font-family: var(--font-ui); font-size: var(--text-sm);
  padding: 8px 10px; border: 1px solid var(--border-strong); border-radius: var(--radius-sm);
  background: #fff; color: var(--ink);
}
.filter-bar select:focus, .filter-bar input:focus { outline: none; border-color: var(--accent); }
.filter-bar .spacer { flex: 1; }

/* ============ ALERTES ============ */
.alert {
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-md);
  font-size: var(--text-sm);
  margin-bottom: var(--space-4);
  border: 1px solid transparent;
}
.alert.success { background: var(--ok-soft); border-color: var(--ok); color: var(--ok); }
.alert.error { background: var(--bad-soft); border-color: var(--bad); color: var(--bad); }
.alert ul { margin: 6px 0 0 18px; }

/* ============ DÉTAILS ============ */
.detail-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-4); }
.detail-item { padding: var(--space-3); border-left: 3px solid var(--border-strong); }
.detail-item dt { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faint); font-weight: 700; }
.detail-item dd { font-size: var(--text-md); font-weight: 600; margin-top: 2px; }
.stack { display: flex; flex-direction: column; gap: var(--space-4); }

/* ============ DIVERS ============ */
.mt-0 { margin-top: 0; } .mt-3 { margin-top: var(--space-3); } .mt-4 { margin-top: var(--space-4); } .mt-5 { margin-top: var(--space-5); }
.mb-0 { margin-bottom: 0; } .mb-3 { margin-bottom: var(--space-3); } .mb-4 { margin-bottom: var(--space-4); }
.mono { font-family: var(--font-mono); font-size: var(--text-sm); }
.avatar-chip { display: inline-flex; align-items: center; gap: 8px; }
.avatar-chip .av {
  width: 30px; height: 30px; border-radius: 50%; background: var(--accent-soft); color: var(--accent-strong);
  display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 11px; flex-shrink: 0;
}
.avatar-chip .av.plain { background: var(--surface-3); color: var(--ink-soft); }
.page-head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-5); flex-wrap: wrap; }
.page-head h1 { font-size: var(--text-2xl); }
.page-head p { color: var(--ink-soft); font-size: var(--text-sm); margin-top: 4px; }
.page-head .marker { margin-top: var(--space-2); }

.scroll-x { overflow-x: auto; }
.hidden { display: none; }

.res-grid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: var(--space-4); align-items: start; }
@media (max-width: 1024px) { .res-grid { grid-template-columns: 1fr; } }
.sum-line { display: flex; justify-content: space-between; padding: 6px 0; font-size: var(--text-sm); color: var(--ink-soft); }
.sum-line b { color: var(--ink); }
.sum-total {
  display: flex; justify-content: space-between; align-items: baseline;
  border-top: 2px solid var(--border); margin-top: var(--space-3); padding-top: var(--space-3);
}
.sum-total .amount { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; color: var(--accent); }
.stay-header { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-4); flex-wrap: wrap; }
.stay-header .nights-chip { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--accent-strong); background: var(--accent-soft); padding: 4px 12px; border-radius: 999px; font-weight: 600; }

/* ============ RESPONSIVE ============ */
@media (max-width: 960px) {
  .sidebar { transform: translateX(-100%); }
  .sidebar.open { transform: translateX(0); }
  .main { margin-left: 0; }
  .login-screen { grid-template-columns: 1fr; }
  .login-brand { display: none; }
  .content { padding: var(--space-4); }
}